<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>true</IsPackable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageId>KafkaWorker</PackageId>
		<Description>.NET Kafka consumer library with automatic retry, dead letter queue, offset management, and DLQ reprocessing. Implement IMessageHandler&lt;TMessage&gt; and the library handles everything else. Includes plain JSON deserialization via System.Text.Json.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/tenzinkabsang/KafkaWorker</RepositoryUrl>
		<Authors>Tenzin Kabsang</Authors>
		<PackageTags>kafka;consumer;dlq;dead-letter-queue;retry;avro;protobuf;json;schema-registry</PackageTags>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
	</PropertyGroup>

	<!-- Allow test project to access internal types -->
	<ItemGroup>
		<InternalsVisibleTo Include="KafkaWorker.Avro" />
		<InternalsVisibleTo Include="KafkaWorker.Protobuf" />
		<InternalsVisibleTo Include="KafkaWorker.JsonSchema" />
		<InternalsVisibleTo Include="KafkaWorker.Tests" />
		<InternalsVisibleTo Include="KafkaWorker.IntegrationTests" />
		<InternalsVisibleTo Include="KafkaWorker.Worker" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" PublicKey="" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="8.0.0" />
	</ItemGroup>
	
	<ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.2" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.2" />
		<PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.2" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Confluent.Kafka" Version="2.13.0" />
		<PackageReference Include="Polly" Version="8.6.5" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
