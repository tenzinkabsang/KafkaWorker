{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "KafkaWorker": {
    "Connection": {
      "BootstrapServers": "localhost:9092"
    },
    "Consumer": {
      "GroupId": "sample-order-processor",
      "Topic": "sample.orders",
      "MaxRetries": 2,
      "DeadLetterTopic": "sample.orders.dlq",
      "DeadLetterProcessingIntervalMinutes": 1,
      "DeadLetterMaxReprocessAttempts": 2
    }
  }
}
